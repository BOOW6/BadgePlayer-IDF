{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ESP-IDF: build",
      "type": "shell",
      "command": "idf.py",
      "args": [
        "-B",
        "${workspaceFolder}/build",
        "build"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "ESP-IDF: flash",
      "type": "shell",
      "command": "idf.py",
      "args": [
        "-B",
        "${workspaceFolder}/build",
        "-b",
        "${config:idf.flashBaudRate}",
        "flash"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "ESP-IDF: build",
      "problemMatcher": []
    },
    {
      "label": "ESP-IDF: monitor",
      "type": "shell",
      "command": "idf.py",
      "args": [
        "-B",
        "${workspaceFolder}/build",
        "monitor"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "ESP-IDF: flash and monitor",
      "dependsOn": [
        "ESP-IDF: flash",
        "ESP-IDF: monitor"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": []
    }
  ]
}
