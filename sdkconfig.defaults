# 本机板卡实测：ESP32-S3 (QFN56) rev0.2 + 16MB Flash + 8MB PSRAM
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# PSRAM（N16R8，Octal 80MHz）
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# 必须填：main.c 里 ESP_ERROR_CHECK(init_wifi())，SSID 为空会直接 abort
CONFIG_BADGE_WIFI_SSID="DX2.4"
CONFIG_BADGE_WIFI_PASSWORD="bs666666"

# 分区表：固件约 1.7MB，默认 single-app 的 factory 仅 1MB 放不下，
# 改用自定义 partitions.csv（factory 4MB + storage 12MB）
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# 控制台日志级别
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
